# Public site identity
# On Vercel, NEXT_PUBLIC_SITE_URL may be omitted until the custom domain is attached;
# Vercel's production URL will be used as a safe fallback for metadata.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SITE_NAME=MyMoneyMetric
NEXT_PUBLIC_SHORT_NAME=MoneyMetric
NEXT_PUBLIC_CONTACT_EMAIL=shafi.rahman979@gmail.com
NEXT_PUBLIC_PUBLISHER_NAME=MyMoneyMetric Editorial Team

# Search verification
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Optional analytics - scripts load only after analytics consent
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=

# Advertising
# Keep false until the property is approved and consent requirements are implemented.
NEXT_PUBLIC_ADS_ENABLED=false
ADSENSE_PUBLISHER_ID=
